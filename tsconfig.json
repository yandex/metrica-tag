{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["esnext", "dom"],
        "types": [],
        "baseUrl": ".",
        "paths": { "@inject": ["./src/inject"] }
    },
    "include": [],
